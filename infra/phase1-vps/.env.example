# Domain & Edge
DOMAIN=afriwork.example.com

# PostgreSQL + PostGIS
POSTGRES_DB=afriwork
POSTGRES_USER=afriwork_app
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://afriwork_app:change_me_strong_password@postgres:5432/afriwork

# Redis
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379

# Meilisearch
MEILI_MASTER_KEY=change_me_meili_key

# Auth & Encryption
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
PII_ENCRYPTION_KMS_KEY=

# S3 / Cloudflare R2
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=afriwork-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payment Providers
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monitoring
GRAFANA_ADMIN_PASSWORD=change_me_grafana
